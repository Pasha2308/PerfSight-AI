# ─── Vertex AI (Recommended — uses GCP credits) ───
GCP_PROJECT_ID=your_gcp_project_id
GCP_LOCATION=us-central1
VERTEX_MODEL_FAST=gemini-2.5-flash
VERTEX_MODEL_REASONING=gemini-2.5-pro

# ─── Fallback: Gemini API Key (for local dev without GCP) ───
# If GCP_PROJECT_ID is set, this is ignored.
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Database ───
DATABASE_URL=./perfsight.db

# ─── Frontend ───
FRONTEND_URL=http://localhost:5173
