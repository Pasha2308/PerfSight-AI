# ─── LLM Provider Routing (vertex | gemini_api | groq | openrouter) ───
LLM_PROVIDER=vertex

# ─── Vertex AI (Recommended — uses GCP credits) ───
GCP_PROJECT_ID=your_gcp_project_id
GCP_LOCATION=us-central1
VERTEX_MODEL_FAST=gemini-2.5-flash
VERTEX_MODEL_REASONING=gemini-2.5-pro

# ─── Fallback: Gemini API Key (for local dev without GCP) ───
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Groq Configuration ───
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_FAST=llama-3.3-70b-versatile
GROQ_MODEL_REASONING=llama-3.3-70b-specdec

# ─── OpenRouter Configuration ───
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL_FAST=google/gemini-2.5-flash
OPENROUTER_MODEL_REASONING=google/gemini-2.5-pro

# ─── Database ───
DATABASE_URL=./perfsight.db

# ─── Frontend ───
FRONTEND_URL=http://localhost:5173
